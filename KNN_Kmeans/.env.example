# Database configuration (PostgreSQL or SQLite)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cybersecurity
# For local development with SQLite, leave empty or use:
# DATABASE_URL=sqlite:///./cybersecurity.db

# Security & Tokens
SECRET_KEY=cybersecurity-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Seed Accounts
SEED_ADMIN_EMAIL=admin@cybersecurity.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ANALYST_EMAIL=analyst@cybersecurity.local
SEED_ANALYST_PASSWORD=Analyst@123456

# Dataset & ML
DEFAULT_DATASET_PATH=dataset/cybersecurity_attacks.csv
MODEL_ARTIFACTS_PATH=ml/artifacts
